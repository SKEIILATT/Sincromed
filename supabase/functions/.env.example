JELOU_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Comma-separated HTTPS hosts used by Jelou/WhatsApp media URLs.
JELOU_MEDIA_HOSTS=media.example.com
# Optional bearer token used when downloading media from Jelou.
JELOU_MEDIA_TOKEN=
JELOU_FUNCTIONS_URL=https://sincromed.fn.jelou.ai
JELOU_APPS_KEY=replace-with-the-jelou-apps-key
